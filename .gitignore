# ==============================================================================
# RakshaVision AI Monorepo — Git Ignore Rules (SIH26187)
# ==============================================================================

# Node / Frontend Artifacts
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
*.local
.npm/

# Virtual Environments & Python Cache
.venv/
backend/.venv/
venv/
ENV/
env/
__pycache__/
backend/app/__pycache__/
backend/app/api/__pycache__/
backend/app/vision/__pycache__/
backend/app/services/__pycache__/
backend/tests/__pycache__/
*.pyc
*.pyo
*.pyd
*.py~
.pytest_cache/
backend/.pytest_cache/

# Databases & Runtime Media
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/snapshots/*.jpg
backend/data/incident_media/*.mp4
backend/data/incident_media/*.jpg
backend/data/sample_videos/*.mp4
backend/data/sample_videos/*.avi
backend/data/sample_videos/*.mkv
!backend/data/.gitkeep
!backend/data/incident_media/.gitkeep
!backend/data/sample_videos/.gitkeep

# ML Model Weights (YOLO)
*.pt
*.onnx
backend/yolov8n.pt

# Secrets & Environment Files
.env
.env.production
backend/.env
frontend/.env
!backend/.env.example
!frontend/.env.example

# IDE & OS Specific
.vscode/
.idea/
.DS_Store
Thumbs.db
